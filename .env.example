# Runtime port.
# Use a different available port for each concurrently running service.
PORT=

# Vite base path. The root artifact uses "/".
BASE_PATH=/

# Optional runtime settings.
NODE_ENV=development
LOG_LEVEL=info

# Optional database connection for the reusable @workspace/db package.
# The current robot simulation keeps its state in API memory and does not
# require a database connection.
DATABASE_URL=